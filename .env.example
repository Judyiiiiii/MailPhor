# Copy these values into your shell or a local .env loader.
# Never commit real credentials or bot tokens.

IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_EMAIL=your-address@qq.com
IMAP_PASSWORD=qq-authorization-code
IMAP_MAILBOX=INBOX
IMAP_LOOKBACK_DAYS=2
IMAP_MARK_AS_READ=false

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
MAX_BODY_CHARS=12000
POLL_SECONDS=300
DASHBOARD_URL=http://localhost:8000/index.html

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
